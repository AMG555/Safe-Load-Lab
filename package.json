{
  "name": "safe-load-lab",
  "version": "2.2.0",
  "description": "Advanced controlled load-testing CLI with A/B differential testing, hermetic mock server, cURL import, spike, soak, stress tests, webhooks, real-time monitoring, response assertions, and retry logic for applications you own or have permission to test",
  "type": "module",
  "bin": {
    "safe-load-lab": "./bin/safe-load-lab.js",
    "sll": "./bin/safe-load-lab.js"
  },
  "main": "./bin/safe-load-lab.js",
  "scripts": {
    "start": "node ./bin/safe-load-lab.js",
    "mock": "node ./bin/safe-load-lab.js mock",
    "ui": "npm --prefix ui start",
    "example": "node ./bin/safe-load-lab.js run --config examples/basic.json --i-own-this-target",
    "validate": "node ./bin/safe-load-lab.js validate --config examples/basic.json",
    "test": "node --test tests/*.test.mjs",
    "test:unit": "node --test tests/unit.test.mjs",
    "test:ab": "node --test tests/ab.test.mjs",
    "test:qa": "node --test tests/qa.test.mjs",
    "test:performance": "node --test tests/performance.test.mjs",
    "test:integration": "node --test tests/integration.test.mjs",
    "test:smoke": "node --test tests/smoke.test.mjs",
    "test:ui": "node --test tests/ui.test.mjs",
    "test:all": "node --test tests/*.test.mjs",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix"
  },
  "keywords": [
    "load-testing",
    "ab-testing",
    "differential-testing",
    "mock-server",
    "curl-import",
    "performance",
    "stress-testing",
    "rate-limit-testing",
    "resilience",
    "benchmark",
    "api-testing",
    "performance-testing",
    "assertions",
    "retry-logic",
    "colored-output"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AMG555/Safe-Load-Lab.git"
  },
  "homepage": "https://github.com/AMG555/Safe-Load-Lab",
  "bugs": {
    "url": "https://github.com/AMG555/Safe-Load-Lab/issues"
  },
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/safe-load-lab"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-progress": "^3.12.0"
  }
}

